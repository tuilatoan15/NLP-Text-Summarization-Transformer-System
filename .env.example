# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
PRELOAD_MODELS=0

# Storage
UPLOAD_DIR=storage/uploads
RESULTS_DIR=storage/results
DOCUMENT_INTELLIGENCE_DIR=storage/document_intelligence
HF_HOME=cache/huggingface
TRANSFORMERS_CACHE=cache/huggingface

# Database
DATABASE_URL=postgresql+asyncpg://agentic:agentic@postgres:5432/agentic_ai
REDIS_URL=redis://redis:6379/0
CELERY_CONCURRENCY=1

# Object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=agentic
MINIO_SECRET_KEY=agentic-secret
MINIO_BUCKET=documents

# Vector stores
CHROMA_HOST=chroma
CHROMA_PORT=8000
VECTOR_BACKEND=local

# Models
DEFAULT_EMBEDDING_MODEL=BAAI/bge-m3
INGEST_USE_VI_SEGMENTER=0
MAX_GPU_CONCURRENT=1
# FORCE_CPU=1 ép toàn bộ inference lên CPU (debug / không có GPU)
FORCE_CPU=0
# Để trống = dùng GPU; "-1" hoặc rỗng trong docker-compose ẩn GPU
CUDA_VISIBLE_DEVICES=

# OCR
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
OCR_LANGUAGES=vie,eng

# RAG Performance Optimization Settings
RAG_USE_RAPTOR=1
RAG_AGENT_MAX_RETRIES=2
RAG_USE_QUERY_EXPANSION=1
RAG_USE_LLM_INTENT=0
RAG_USE_LLM_JUDGE=1
RAG_SKIP_JUDGE_MIN_RERANK=0.72
RAG_EVALUATE_HALLUCINATION=0
RAG_RESPONSE_CACHE=1
RAG_RETRIEVAL_CACHE=1
RAG_RESPONSE_CACHE_TTL=300
RAG_RETRIEVAL_CACHE_TTL=600
RAG_EMBEDDING_FP16=1
RAG_EMBEDDING_BATCH_SIZE=32
RAG_RERANKER_BATCH_SIZE=16
RAG_RERANKER_FP16=1
RAG_PARALLEL_RETRIEVAL=1
RAG_RAPTOR_BACKGROUND=1
RAG_VERBOSE_LOG=0
RAG_SENTENCE_EMBED_CACHE=1
WARM_ANALYTICS_CACHE=0
DATASET_ANALYTICS_CACHE=1
DATASET_ANALYTICS_LIMIT=0
PRELOAD_MODELS_LIST=vit5
PRELOAD_RAG_MODELS=1
RAG_TORCH_COMPILE=0
RAG_EXPANSION_CACHE=1
RAG_EXPANSION_CACHE_TTL=1800
RAG_EXPANSION_MIN_WORDS=3
RAG_SUMMARIZE_BATCH_SIZE=4
# Hybrid Context Compression (ChatRAG)
RAG_CONTEXT_COMPRESSION=1
RAG_CONTEXT_COMPRESSION_THRESHOLD=2500
RAG_TOP_ORIGINAL_CHUNKS=3
RAG_SUMMARY_FOR_LONG_CONTEXT_ONLY=1
RAG_RETRIEVAL_FINAL_TOP_K=10
# Adaptive Context Builder (nâng cấp Context Compression)
RAG_ADAPTIVE_CONTEXT=1
RAG_DYNAMIC_CHUNK_RATIO=0.9
RAG_MIN_RERANK_SCORE=0.85
RAG_LIGHT_COMPRESSION=1500
RAG_MEDIUM_COMPRESSION=3000
RAG_HEAVY_COMPRESSION=6000
RAG_ADAPTIVE_CONTEXT_CACHE=1
RAG_ADAPTIVE_CONTEXT_CACHE_TTL=600
# A/B 2026-07-03: faithfulness beam3=76.57% vs beam5=76.35% (Δ−0.22%) trên 50 câu — chấp nhận
RAG_GEN_NUM_BEAMS=3
# RAG_GEN_LENGTH_PENALTY=
# RAG_GEN_REPETITION_PENALTY=
COMPARE_PIPELINE_V2=1
